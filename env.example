# Mystery Agents - Environment Variables Configuration
# Copy this file to .env and fill in your values

# Text provider: "openai" (default) or "google". Images always use Gemini.
# LLM_PROVIDER=openai

# OpenAI API key (text, when LLM_PROVIDER=openai)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-key-here

# Google Gemini API key (portraits; text too when LLM_PROVIDER=google).
# Not needed with --no-images and LLM_PROVIDER=openai.
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-key-here

# Optional: Override the provider's model per tier
# Defaults: gpt-6-luna for every tier (openai); gemini-3.6-flash, gemini-3.6-flash
# and gemini-3.5-flash-lite (google)
# LLM_MODEL_TIER1=gpt-6-luna
# LLM_MODEL_TIER2=gpt-6-luna
# LLM_MODEL_TIER3=gpt-6-luna

# Optional: reasoning effort per tier (low, medium, high; OpenAI also none, xhigh, max).
# OpenAI defaults: medium for tier 1 (plan, grid, sheets, content, reviews), low for
# tiers 2-3. Gemini keeps each model's own default unless set here.
# LLM_REASONING_EFFORT_TIER1=medium
# LLM_REASONING_EFFORT_TIER2=low
# LLM_REASONING_EFFORT_TIER3=low

# Optional: Override temperatures per tier (unset by default; Gemini 3.6+
# models use fixed sampling and ignore them)
# LLM_TEMPERATURE_TIER1=0.9
# LLM_TEMPERATURE_TIER2=0.8
# LLM_TEMPERATURE_TIER3=0.3

