# Mystery Agents - Environment Variables Configuration
# Copy this file to .env and fill in your values

# Text provider: "google" (default, Gemini) or "openai". Images always use Gemini.
# LLM_PROVIDER=google

# Google Gemini API key (text by default, and portraits)
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-key-here

# OpenAI API key (text, only when LLM_PROVIDER=openai)
# Get your API key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-key-here

# Optional: Override the provider's model per tier
# Defaults: gemini-3.8-flash (tiers 1-2) and gemini-3.5-flash-lite (tier 3) for google;
# gpt-6-luna for every tier for openai
# LLM_MODEL_TIER1=gemini-3.8-flash
# LLM_MODEL_TIER2=gemini-3.8-flash

# Optional: reasoning effort per tier (low, medium, high; OpenAI also none, xhigh, max).
# Defaults for both providers: medium for tier 1 (plan, grid, sheets, content, reviews)
# and low for tier 2.
# LLM_REASONING_EFFORT_TIER1=medium
# LLM_REASONING_EFFORT_TIER2=low

# Optional: Override temperatures per tier (unset by default; Gemini 3.6+
# models use fixed sampling and ignore them)
# LLM_TEMPERATURE_TIER1=0.9
# LLM_TEMPERATURE_TIER2=0.8
# LLM_TEMPERATURE_TIER3=0.3

